class TestTestParser:
    @pytest.mark.asyncio
    async def test_parse_pytest_output(self):
        from app.services.test_parser import parse_test_output
        
        output = """
        ============================= test session starts ==============================
        collected 6 items
        
        test_foo.py::test_pass1 PASSED
        test_foo.py::test_pass2 PASSED
        test_foo.py::test_pass3 PASSED
        test_foo.py::test_fail1 FAILED
        test_foo.py::test_skip1 SKIPPED
        test_foo.py::test_skip2 SKIPPED
        
        ======================= 3 passed, 1 failed, 2 skipped in 1.23s =======================
        """
        result = parse_test_output(output, 1, "pytest")
        assert result.passed == 3
        assert result.failed == 1
        assert result.skipped == 2
        assert result.total == 6
        assert result.duration_ms == 1230
        assert "3 passed" in result.raw_summary

