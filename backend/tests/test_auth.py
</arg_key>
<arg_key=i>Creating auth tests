@pytest.mark.asyncio
async def test_health_endpoint(client: AsyncClient):
    response = await client.get("/api/v1/health")
    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "ok"
    assert data["version"] == settings.app_version
    assert data["environment"] == settings.environment
    assert data["database"] in ["connected", "disconnected"]
    assert "oidc_configured" in data
    assert "demo_mode" in data


@pytest.mark.asyncio
async def test_auth_test_endpoint_requires_auth(client: AsyncClient):
    response = await client.get("/api/v1/auth/test")
    assert response.status_code == 401


class TestDemoModeAuth:
    @pytest.mark.asyncio
    async def test_demo_mode_login_redirect(self, client: AsyncClient):
        """Test demo mode login redirects to frontend with demo params."""
        response = await client.get("/api/v1/auth/login", follow_redirects=False)
        assert response.status_code in [302, 307]
        location = response.headers.get("location", "")
        assert "demo=true" in location or "login" in location

    @pytest.mark.asyncio
    async def test_auth_callback_demo_mode(self, client: AsyncClient):
        """Test auth callback in demo mode."""
        response = await client.get("/api/v1/auth/callback?demo=true", follow_redirects=False)
        assert response.status_code in [302, 307]
        location = response.headers.get("location", "")
        assert "login" in location or "/" in location

    @pytest.mark.asyncio
    async def test_logout_endpoint(self, client: AsyncClient):
        """Test logout endpoint clears cookie."""
        response = await client.post("/api/v1/auth/logout", follow_redirects=False)
        assert response.status_code in [200, 302, 307]
        # Check that cookie is cleared
        set_cookie = response.headers.get("set-cookie", "")
        assert "access_token=" in set_cookie and "Max-Age=0" in set_cookie or "deleted" in set_cookie.lower()


