# Application
APP_NAME=beacon-station
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./beacon.db
DATABASE_ECHO=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keycloak / OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/beacon-station
OIDC_CLIENT_ID=beacon-station
OIDC_CLIENT_SECRET=changeme-in-production
OIDC_AUDIENCE=beacon-station
OIDC_JWKS_URL=http://localhost:8080/realms/beacon-station/protocol/openid-connect/certs

# Demo mode (local only, refuses in production)
DEMO_MODE=true

# LLM
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Paths
PLANS_ROOT=./data/plans
CLAUDE_CONFIG_DIR=~/.claude